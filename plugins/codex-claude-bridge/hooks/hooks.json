{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "exec codex-claude-bridge codex-session-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "exec codex-claude-bridge codex-session-hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
