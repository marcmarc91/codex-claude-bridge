{
  "name": "codex-claude-bridge",
  "version": "0.1.1",
  "private": true,
  "description": "Local session messaging, acknowledgements and delivery diagnostics for Codex and Claude Code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcmarc91/codex-claude-bridge.git",
    "directory": "plugins/codex-claude-bridge"
  },
  "homepage": "https://github.com/marcmarc91/codex-claude-bridge#readme",
  "bugs": {
    "url": "https://github.com/marcmarc91/codex-claude-bridge/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "os": ["darwin"],
  "keywords": ["codex", "claude-code", "mcp", "agent-messaging"],
  "type": "module",
  "bin": {
    "codex-claude-bridge": "dist/bin/codexClaudeBridge.js",
    "claude-code-bridge-wrapper": "dist/bin/claudeCodeBridgeWrapper.js"
  },
  "scripts": {
    "bridge": "node dist/bin/codexClaudeBridge.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
